<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c1017">

    <!-- Screen 1: In-App Live DropFile Dashboard (WebView) -->
    <LinearLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top In-App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="12dp"
            android:background="#151a24">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/logo_icon"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSettingsFromWeb"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚙️ Server IP"
                android:textSize="12sp"
                android:textColor="#cbd5e1"
                android:background="#0f141d"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- Embedded Full-Screen WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Screen 2: Connection & IP Settings View -->
    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/logo_icon"
                android:scaleType="fitCenter"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Phone &lt;-&gt; PC File Transfer"
                android:textSize="14sp"
                android:textColor="#9ca3af"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Server Address:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#f3f4f6"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#151a24"
                android:textColor="#00f2fe"
                android:textSize="16sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:hint="http://192.168.0.101:4000"
                android:textColorHint="#4b5563"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save &amp; Connect to PC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="#2563eb"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/openWebBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📥 Open In-App File Dashboard"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#00f2fe"
                android:background="#151a24"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/pickFileBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📁 Send File to PC Now"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#f3f4f6"
                android:background="#151a24"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to connect"
                android:textSize="14sp"
                android:textColor="#34d399"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1f293d"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 How to share from ANY app:"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Open any document in Google Drive, DocScan, Files, or WhatsApp.\n\n2. Tap the normal 'Share' icon.\n\n3. Select 'Send to PC (V-Share)' from the app list.\n\n4. Your document will instantly upload straight to your PC!"
                android:textSize="13sp"
                android:textColor="#9ca3af"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
