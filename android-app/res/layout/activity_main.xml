<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c1017">

    <!-- Screen 1: In-App Live DropFile Dashboard (WebView) -->
    <LinearLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top In-App Bar -->
        <LinearLayout
            android:id="@+id/webHeader"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="12dp"
            android:background="#151a24">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/logo_icon"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSettingsFromWeb"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚙️ Server IP"
                android:textSize="12sp"
                android:textColor="#cbd5e1"
                android:background="#0f141d"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- Embedded Full-Screen WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Screen 2: Connection & IP Settings View -->
    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/logo_icon"
                android:scaleType="fitCenter"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Phone &lt;-&gt; PC File Transfer"
                android:textSize="14sp"
                android:textColor="#9ca3af"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Server Address:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#f3f4f6"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#151a24"
                android:textColor="#00f2fe"
                android:textSize="16sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:hint="https://v-share-o68m.onrender.com"
                android:textColorHint="#4b5563"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save &amp; Connect to PC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="#2563eb"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/openWebBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📥 Open In-App File Dashboard"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#00f2fe"
                android:background="#151a24"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/pickFileBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📁 Send File to PC Now"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#f3f4f6"
                android:background="#151a24"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to connect"
                android:textSize="14sp"
                android:textColor="#34d399"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1f293d"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Complete Guide: How to Use V-Share"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00f2fe"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1️⃣ Send from In-App Dashboard:\nTap 'Open In-App File Dashboard' above. Tap any file or photo to drop it instantly to your PC.\n\n2️⃣ Share from ANY Other App:\nIn Google Drive, DocScan, Gallery, Files, or WhatsApp, tap the normal 'Share' icon and choose 'Send to PC (V-Share)'. The document streams straight to your computer!\n\n3️⃣ Multiple PCs on Same Wi-Fi:\nAt the top of the dashboard, you will see your target PCs. Simply tap the PC you want to send to!\n\n4️⃣ Where Files Land on PC:\nFiles automatically save directly into your PC's folder (Downloads\\Submitt) — even when the V-Share window is closed!"
                android:textSize="13sp"
                android:textColor="#9ca3af"
                android:lineSpacingMultiplier="1.35" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
